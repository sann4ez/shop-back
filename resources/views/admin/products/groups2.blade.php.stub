@push('scripts')
    <script>
        $('.js-mass-check-all').on('change', function () {
            if(this.checked){
                $('.js-mass-check').prop('checked', true);
            } else {
                $('.js-mass-check').prop('checked', false);
            }
        })
    </script>
@endpush

